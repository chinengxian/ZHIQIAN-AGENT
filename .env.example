AGENT_MODEL_PROVIDER=openai
AGENT_OPENAI_BASE_URL=https://api.example.com/v1
AGENT_OPENAI_API_KEY=replace-me
AGENT_OPENAI_MODEL=replace-me

# Anthropic alternative (replace the active OpenAI block above):
# AGENT_MODEL_PROVIDER=anthropic
# AGENT_ANTHROPIC_API_KEY=replace-me
# AGENT_ANTHROPIC_MODEL=replace-me
# AGENT_ANTHROPIC_BASE_URL=https://api.anthropic.com

# 原生知识库总开关；设为 false 时只启动原有聊天能力。
AGENT_KNOWLEDGE_ENABLED=true
AGENT_DATABASE_URL=postgresql+asyncpg://agent:agent@127.0.0.1:5432/agent
AGENT_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_STORAGE_ROOT=./data/uploads
AGENT_MAX_UPLOAD_BYTES=52428800

AGENT_MILVUS_URI=http://127.0.0.1:19530
# AGENT_MILVUS_TOKEN=
AGENT_MILVUS_COLLECTION=knowledge_chunks

# Embedding 与聊天模型独立配置，可使用不同服务和模型。
AGENT_EMBEDDING_PROVIDER=openai
AGENT_EMBEDDING_BASE_URL=https://api.example.com/v1
AGENT_EMBEDDING_API_KEY=replace-me
AGENT_EMBEDDING_MODEL=replace-me
AGENT_EMBEDDING_DIMENSION=1536
AGENT_EMBEDDING_BATCH_SIZE=32

AGENT_RERANK_PROVIDER=none
# AGENT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
AGENT_RERANK_DEVICE=cpu
AGENT_RERANK_BATCH_SIZE=8
